#!/bin/sh
set -eu

[ "$#" -eq 2 ] || { echo 'Usage: dwl-codex server|window SOCKET' >&2; exit 2; }
socket=$2
unset TMUX

case $1 in
server)
    exec tmux -D -S "$socket" -f /dev/stdin <<'EOF'
set -g status off
set -g default-terminal tmux-256color
# foot otherwise translates the wheel to arrow keys on tmux's alternate screen.
set -g mouse on
set -g history-limit 50000
set -g remain-on-exit on
set -g remain-on-exit-format 'Codex exited (#{pane_dead_status}). Press Enter for a fresh chat.'
bind -n Enter if -F '#{pane_dead}' 'respawn-pane' 'send-keys Enter'
new-session -d -s codex -c "$HOME/Vault/Agents" -x 100 -y 32 codex --no-alt-screen
EOF
    ;;
window)
    i=0
    while ! tmux -N -S "$socket" show-options -s >/dev/null 2>&1; do
        if [ "$i" -ge 100 ]; then
            echo 'dwl-codex: tmux server did not become ready' >&2
            exit 1
        fi
        sleep 0.02
        i=$((i + 1))
    done
    # Only the foreground server may create the socket and own Codex.
    if ! tmux -N -S "$socket" has-session -t =codex 2>/dev/null; then
        tmux -N -S "$socket" new-session -d -s codex -c "$HOME/Vault/Agents" -x 100 -y 32 codex --no-alt-screen
    fi

    footsocket=${XDG_RUNTIME_DIR:?}/foot-${WAYLAND_DISPLAY:?}.sock
    i=0
    while [ ! -S "$footsocket" ] && [ "$i" -lt 100 ]; do
        sleep 0.02
        i=$((i + 1))
    done
    if [ -S "$footsocket" ]; then
        exec footclient -E --app-id=codex-popup --title=Codex \
            tmux -N -S "$socket" attach-session -t codex
    fi
    exec foot --app-id=codex-popup --title=Codex \
        tmux -N -S "$socket" attach-session -t codex
    ;;
*)
    echo 'Usage: dwl-codex server|window SOCKET' >&2
    exit 2
    ;;
esac
